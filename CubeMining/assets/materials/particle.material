name: "particle"
tags: "model"
vertex_program: "/assets/materials/billboard.vp"
fragment_program: "/assets/materials/particle.fp"
vertex_constants {
  name: "view_proj"
  type: CONSTANT_TYPE_VIEWPROJ
}
vertex_constants {
  name: "proj"
  type: CONSTANT_TYPE_PROJECTION
}
vertex_constants {
  name: "view"
  type: CONSTANT_TYPE_VIEW
}
fragment_constants {
  name: "atlas_bounds"
  type: CONSTANT_TYPE_USER
  value {
    z: 1.0
    w: 1.0
  }
}
fragment_constants {
  name: "light_tint"
  type: CONSTANT_TYPE_USER
  value {
    x: 1.0
    y: 1.0
    z: 1.0
    w: 1.0
  }
}
samplers {
  name: "texture0"
  wrap_u: WRAP_MODE_CLAMP_TO_EDGE
  wrap_v: WRAP_MODE_CLAMP_TO_EDGE
  filter_min: FILTER_MODE_MIN_NEAREST_MIPMAP_LINEAR
  filter_mag: FILTER_MODE_MAG_NEAREST
}
attributes {
  name: "position"
  semantic_type: SEMANTIC_TYPE_POSITION
}
attributes {
  name: "mtx_world"
  semantic_type: SEMANTIC_TYPE_WORLD_MATRIX
  coordinate_space: COORDINATE_SPACE_WORLD
  vector_type: VECTOR_TYPE_MAT4
}
attributes {
  name: "texcoord0"
  semantic_type: SEMANTIC_TYPE_TEXCOORD
  double_values {
    v: 0.0
    v: 0.0
    v: 0.0
    v: 0.0
  }
}
attributes {
  name: "color"
  semantic_type: SEMANTIC_TYPE_COLOR
  double_values {
    v: 1.0
    v: 1.0
    v: 1.0
    v: 1.0
  }
}
attributes {
  name: "billboard_mode"
  double_values {
    v: 0.0
  }
  vector_type: VECTOR_TYPE_SCALAR
}
