-- main/scripts/fog_manager.script
-- Singleton manager for entity fog to avoid per-entity update loops.

function init(self)
    self.timer = 0
    _G.fog_entities = _G.fog_entities or {}
    
    _G.update_single_fog = function(id, model_url)
        local cam_pos = _G.camera_world_pos
        local fog_dist = _G.fog_distance
        
        if cam_pos and fog_dist then
            local ok, my_pos = pcall(go.get_world_position, id)
            if ok then
                local dist = vmath.length(my_pos - cam_pos)
                local factor = 1.0
                if dist > fog_dist.x then
                    factor = 1.0 - math.min(1.0, (dist - fog_dist.x) / (fog_dist.y - fog_dist.x))
                end
                pcall(model.set_constant, model_url, "fog_factor", vmath.vector4(factor, 0, 0, 0))
            else
                _G.fog_entities[id] = nil
            end
        end
    end
end

function update(self, dt)
    self.timer = self.timer + dt
    if self.timer >= 0.1 then
        self.timer = 0
        for id, model_url in pairs(_G.fog_entities) do
            _G.update_single_fog(id, model_url)
        end
    end
end
