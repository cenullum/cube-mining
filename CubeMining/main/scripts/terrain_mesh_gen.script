-- terrain_mesh_gen.script
-- Thin Lua wrapper: buffer creation, GPU upload, message handling.
-- All heavy work (mesh gen, AO, lighting) runs in C++ on a background thread.

local block_data = require "main.scripts.block_data"
local world = require "main.scripts.world_data_storage"
local sm = require "main.scripts.sound_manager"

local vmath = vmath
local resource = resource
local buffer = buffer
local go = go
local msg = msg
local factory = factory
local hash = hash

go.property("mesh_prefab", msg.url())
go.property("game_atlas", resource.atlas())
go.property("grid_size", 16)
go.property("torch_factory", msg.url())
go.property("breaking_texture", resource.texture("/assets/images/effects/breaking.png"))

local TEMP_POS = vmath.vector3()

local H_MESH = hash("mesh")
local H_POSITION = hash("position")
local H_TEXCOORD0 = hash("texcoord0")
local H_TEXCOORD1 = hash("texcoord1")
local H_TEXCOORD2 = hash("texcoord2")
local H_COLOR = hash("color")
local H_COLOR1 = hash("color1")
local H_COLOR2 = hash("color2")
local H_DESTROY_CUBE = hash("destroy_cube")
local H_PLACE_CUBE = hash("place_cube")
local H_TEXTURE0 = hash("texture0")
local H_VERTICES = hash("vertices")
local H_TOGGLE_AO = hash("toggle_ao")
local H_TOGGLE_LIGHT_MODE = hash("toggle_light_mode")
local H_SET_BLOCKS_AREA = hash("set_blocks_area")
local H_SET_BLOCKS_LIST = hash("set_blocks_list")
local H_TEXTURE1 = hash("texture1")
local H_NORMAL = hash("normal")

local PATCH_BUFFER = "/assets/model/patch_%s.bufferc"

_G.stats_faces = 0
_G.stats_vertices = 0
_G.stats_mesh_build_time = 0
_G.world_build_times = {}

local function create_mesh(self)
    local grid_size = self.grid_size or 16
    local offset = -grid_size / 2 + 0.5
    local pos = vmath.vector3(offset, offset, 490)

    local object = {}
    object.go_id = factory.create(self.mesh_prefab, pos)
    object.mesh_url = msg.url(object.go_id)
    object.mesh_url.fragment = H_MESH
    return object
end

local function request_mesh_update(self)
    terrain.request_mesh_update(self.ao_enabled, self.light_mode)
    self.mesh_pending = true
end

local function register_blocks(self)
    local atlas = resource.get_atlas(self.game_atlas)
    block_data.init(self.game_atlas)

    -- Register each block with C++ engine
    for id = 0, 255 do
        local def = block_data.get_block(id)
        if def then
            local uvs = nil
            if def.uvs then
                uvs = {}
                for face = 1, 6 do
                    local uv = def.uvs[face]
                    if uv then
                        uvs[face] = { uv.u, uv.v, uv.w, uv.h }
                    else
                        uvs[face] = { 0, 0, 0, 0 }
                    end
                end
            end
            terrain.register_block(id, def.transparent or false, def.solid or false, def.light_level or 0, uvs)
        end
    end
end

local function create_chunk(self)
    local mesh_go = create_mesh(self)
    local grid_size = self.grid_size
    _G.grid_size = grid_size

    local atlas = resource.get_atlas(self.game_atlas)
    go.set(mesh_go.mesh_url, H_TEXTURE0, hash(atlas.texture))
    go.set(mesh_go.mesh_url, H_TEXTURE1, self.breaking_texture)

    -- Allocate initial buffer matching the C++ max size
    local max_verts      = terrain.get_max_vertices()
    local buf            = buffer.create(max_verts, {
        { name = H_POSITION,  type = buffer.VALUE_TYPE_FLOAT32, count = 3 },
        { name = H_TEXCOORD0, type = buffer.VALUE_TYPE_FLOAT32, count = 4 }, -- base_uv, unit_size
        { name = H_TEXCOORD1, type = buffer.VALUE_TYPE_FLOAT32, count = 4 }, -- local_uv, quad_size
        { name = H_COLOR,     type = buffer.VALUE_TYPE_UINT8,   count = 4 }, -- AO
        { name = H_COLOR1,    type = buffer.VALUE_TYPE_UINT8,   count = 4 }, -- Torch
        { name = H_COLOR2,    type = buffer.VALUE_TYPE_UINT8,   count = 4 }, -- Sun
        { name = H_TEXCOORD2, type = buffer.VALUE_TYPE_FLOAT32, count = 1 }  -- face_id
    })

    self.buf             = buf
    self.mesh_url        = mesh_go.mesh_url
    _G.terrain_mesh_url  = mesh_go.mesh_url
    self.buffer_resource = resource.create_buffer(string.format(PATCH_BUFFER, 7), { buffer = buf })
    go.set(self.mesh_url, H_VERTICES, self.buffer_resource)

    self.max_verts    = max_verts

    -- Build shared_cubemap
    _G.shared_cubemap = {}
    for cx = 0, grid_size - 1 do
        for cy = 0, grid_size - 1 do
            for cz = 0, grid_size - 1 do
                if world.get_block(cx, cy, cz) ~= 0 then
                    local cube_idx = cx + cy * grid_size + cz * grid_size * grid_size
                    _G.shared_cubemap[cube_idx] = true
                end
            end
        end
    end

    -- Initial mesh update (synchronous lighting + async mesh)
    world.recalculate_lighting()
    request_mesh_update(self)
end

function init(self)
    local grid_size = self.grid_size

    self.ao_enabled = true
    self.light_mode = 1 -- 0: Flat, 1: Smooth, 2: Off
    _G.ao_enabled = true
    _G.light_mode = 1
    self.block_entities = {}
    self.mesh_pending = false

    -- Initialize C++ world storage and generate terrain
    world.init(grid_size, os.time())

    -- Register block data with C++
    register_blocks(self)

    create_chunk(self)
    msg.post(".", "acquire_input_focus")
end

function update(self, dt)
    -- Poll for mesh results from the worker thread
    if self.mesh_pending then
        local buf, vc, fc, qc, b_time = terrain.poll_mesh_buffer()
        if buf then
            -- Note: vc is current active verts, but buf has max_verts size to match resource
            print("terrain_mesh_gen: Applying mesh... verts=" .. vc .. " time=" .. string.format("%.2f", b_time) .. "ms")

            -- resource.set_buffer updates the GPU memory.
            -- Using a fixed-size resource avoids expensive re-allocations and culling issues.
            resource.set_buffer(self.buffer_resource, buf)

            _G.stats_faces = fc
            _G.stats_vertices = vc

            _G.stats_mesh_build_time = b_time
            table.insert(_G.world_build_times, b_time)
            if #_G.world_build_times > 25 then
                table.remove(_G.world_build_times, 1)
            end

            self.mesh_pending = false
        elseif vc == 0 then
            -- Empty result (all air) handled by the fallback in the C++ extension returning buf=nil, vc=0
            print("terrain_mesh_gen: Empty chunk result")
            self.mesh_pending = false
        end
    end
end

function on_message(self, message_id, message, sender)
    local grid_size = self.grid_size
    if message_id == H_DESTROY_CUBE then
        local gx, gy, gz = message.gx, message.gy, message.gz
        if gx and gy and gz and grid_size then
            local b_id = world.get_block(gx, gy, gz)
            if b_id ~= 0 and b_id ~= 2 then
                local offset = -grid_size / 2 + 0.5
                TEMP_POS.x = offset + gx
                TEMP_POS.y = offset + gy
                TEMP_POS.z = 490 + gz

                local b_def = block_data.get_block(b_id)
                if b_def and b_def.break_sound then
                    sm.play(b_def.break_sound, 1.0, TEMP_POS)
                else
                    sm.play(sm.stone_debris, 1.0, TEMP_POS)
                end

                world.set_block(gx, gy, gz, 0)

                local e_key = gx .. "_" .. gy .. "_" .. gz
                if self.block_entities[e_key] then
                    go.delete(self.block_entities[e_key])
                    self.block_entities[e_key] = nil
                end

                local cube_idx = gx + gy * grid_size + gz * grid_size * grid_size
                if _G.shared_cubemap then _G.shared_cubemap[cube_idx] = false end
                request_mesh_update(self)
            end
        end
    elseif message_id == H_PLACE_CUBE then
        local gx, gy, gz = message.gx, message.gy, message.gz
        local target_id = message.block_id or 1
        if gx and gy and gz and grid_size then
            if gx >= 0 and gx < grid_size and gy >= 0 and gy < grid_size and gz >= 0 and gz < grid_size then
                if world.get_block(gx, gy, gz) == 0 then
                    world.set_block(gx, gy, gz, target_id)

                    if target_id == 12 and self.torch_factory then
                        local offset = -grid_size / 2 + 0.5
                        local pos = vmath.vector3(offset + gx, offset + gy, 490 + gz)
                        local t_id = factory.create(self.torch_factory, pos)
                        self.block_entities[gx .. "_" .. gy .. "_" .. gz] = t_id
                        pcall(function() go.set(msg.url(nil, t_id, "model"), "tint", vmath.vector4(1, 1, 1, 1)) end)
                        sm.play(sm.place, 1.0, pos)
                    else
                        local offset = -grid_size / 2 + 0.5
                        local pos = vmath.vector3(offset + gx, offset + gy, 490 + gz)
                        sm.play(sm.place, 1.0, pos)
                    end

                    local cube_idx = gx + gy * grid_size + gz * grid_size * grid_size
                    if _G.shared_cubemap then _G.shared_cubemap[cube_idx] = true end
                    request_mesh_update(self)
                end
            end
        end
    elseif message_id == H_SET_BLOCKS_AREA then
        local center_gx, center_gy, center_gz = message.gx, message.gy, message.gz
        local radius = message.radius or 1
        local target_id = message.block_id or 0
        local modified = false

        if center_gx and center_gy and center_gz and grid_size then
            local offset = -grid_size / 2 + 0.5
            for gx = center_gx - radius, center_gx + radius do
                for gy = center_gy - radius, center_gy + radius do
                    for gz = center_gz - radius, center_gz + radius do
                        if gx >= 0 and gx < grid_size and
                            gy > 0 and gy < grid_size and
                            gz >= 0 and gz < grid_size then
                            local current_id = world.get_block(gx, gy, gz)
                            if current_id ~= target_id and current_id ~= 2 then
                                world.set_block(gx, gy, gz, target_id)
                                local cube_idx = gx + gy * grid_size + gz * grid_size * grid_size
                                if target_id == 0 then
                                    if _G.shared_cubemap then _G.shared_cubemap[cube_idx] = false end
                                    local e_key = gx .. "_" .. gy .. "_" .. gz
                                    if self.block_entities[e_key] then
                                        pcall(go.delete, self.block_entities[e_key])
                                        self.block_entities[e_key] = nil
                                    end
                                    TEMP_POS.x = offset + gx
                                    TEMP_POS.y = offset + gy
                                    TEMP_POS.z = 490 + gz
                                    sm.play(sm.stone_debris, 1.0, TEMP_POS)
                                else
                                    if _G.shared_cubemap then _G.shared_cubemap[cube_idx] = true end
                                end
                                modified = true
                            end
                        end
                    end
                end
            end
            if modified then
                request_mesh_update(self)
            end
        end
    elseif message_id == H_SET_BLOCKS_LIST then
        local blocks = message.blocks
        local modified = false
        if blocks and grid_size then
            local offset = -grid_size / 2 + 0.5
            for _, b in ipairs(blocks) do
                local gx, gy, gz, target_id = b.gx, b.gy, b.gz, b.id or 0
                if gx and gy and gz then
                    if gx >= 0 and gx < grid_size and
                        gy > 0 and gy < grid_size and
                        gz >= 0 and gz < grid_size then
                        local current_id = world.get_block(gx, gy, gz)
                        if current_id ~= target_id and current_id ~= 2 then
                            world.set_block(gx, gy, gz, target_id)
                            local cube_idx = gx + gy * grid_size + gz * grid_size * grid_size
                            if target_id == 0 then
                                if _G.shared_cubemap then _G.shared_cubemap[cube_idx] = false end
                                local e_key = gx .. "_" .. gy .. "_" .. gz
                                if self.block_entities[e_key] then
                                    go.delete(self.block_entities[e_key])
                                    self.block_entities[e_key] = nil
                                end
                                TEMP_POS.x = offset + gx
                                TEMP_POS.y = offset + gy
                                TEMP_POS.z = 490 + gz
                                sm.play(sm.stone_debris, 1.0, TEMP_POS)
                            else
                                if _G.shared_cubemap then _G.shared_cubemap[cube_idx] = true end
                            end
                            modified = true
                        end
                    end
                end
            end
            if modified then
                request_mesh_update(self)
            end
        end
    elseif message_id == H_TOGGLE_AO then
        self.ao_enabled = not self.ao_enabled
        _G.ao_enabled = self.ao_enabled
        request_mesh_update(self)
        print("AO Enabled: " .. tostring(self.ao_enabled))
    elseif message_id == H_TOGGLE_LIGHT_MODE then
        self.light_mode = (self.light_mode + 1) % 3
        _G.light_mode = self.light_mode
        request_mesh_update(self)
        local modes = { "Flat", "Smooth", "Off" }
        print("Lighting Mode: " .. modes[self.light_mode + 1])
    end
end

function final(self)
    resource.release(string.format(PATCH_BUFFER, 7))
    terrain.shutdown()
end
